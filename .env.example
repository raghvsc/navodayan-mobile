# Flutter API Configuration
#
# By default, ApiConfig automatically chooses:
# - Android Emulator: http://10.0.2.2:5000/api
# - iOS Simulator / Web / Desktop: http://127.0.0.1:5000/api
#
# To override the API base URL at run/build time, pass --dart-define:
# flutter run --dart-define=API_BASE_URL=http://YOUR_LAN_IP:5000/api
# flutter run --dart-define=API_BASE_URL=https://2v7xgmkczk.us-east-1.awsapprunner.com/api
#
# To pass client key for authorized API access:
# flutter run --dart-define=NAVODAYAN_CLIENT_KEY=YOUR_KEY
